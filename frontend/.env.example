# Base URL of the NestJS backend, including its global /api/v1 prefix.
# The backend sets app.setGlobalPrefix('api/v1') in src/main.ts.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Paystack PUBLIC key, used by the inline checkout popup. Safe to expose - it
# only ever initiates a payment, it cannot move money on its own.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_replace_me

# NOTE: every variable in this file is bundled into the browser build.
# Never put JWT_SECRET, database credentials, Cloudinary API secrets or any
# payment provider SECRET key here. Those belong in the backend .env only.
